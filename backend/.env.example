# Base de datos PostgreSQL (Render provee esto)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Puerto del servidor
PORT=3001

# URL del frontend (para CORS)
FRONTEND_URL="http://localhost:5173"

# Firebase Admin SDK (descargar de Firebase Console)
FIREBASE_PROJECT_ID="tu-proyecto-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com"

# Cloudinary (para imágenes)
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

# Web Push (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY="tu-vapid-public-key"
VAPID_PRIVATE_KEY="tu-vapid-private-key"
VAPID_EMAIL="mailto:tu-email@example.com"

# JWT Secret (para sesiones)
JWT_SECRET="un-secreto-muy-seguro-y-largo"
